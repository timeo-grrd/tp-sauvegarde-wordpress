# /etc/cron.d/wp-backup — sauvegarde chiffrée WordPress vers MinIO
# Format : minute heure jour-du-mois mois jour-de-la-semaine UTILISATEUR commande
# Ici : tous les jours à 12h17 (la VM doit être allumée à cette heure-là).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

17 12 * * * root /opt/wp-backup/backup.sh >> /var/log/wp-backup.log 2>&1
